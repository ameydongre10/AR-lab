    <Compile Include="../../../Assets/Tests/EditMode/DigitalLogicSimulatorTests.cs" Link="Tests/DigitalLogicSimulatorTests.cs" />
    <Compile Include="../../../Assets/Tests/EditMode/IcDefinitionTests.cs" Link="Tests/IcDefinitionTests.cs" />
    <Compile Include="../../../Assets/Tests/EditMode/LogicValueTests.cs" Link="Tests/LogicValueTests.cs" />
