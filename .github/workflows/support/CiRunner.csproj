  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../../Assets/Scripts/Core/EventBus.cs" Link="Core/EventBus.cs" />
    <Compile Include="../../../Assets/Scripts/Core/GameEvents.cs" Link="Core/GameEvents.cs" />
    <Compile Include="../../../Assets/Scripts/Simulation/*.cs" Link="Simulation/%(Filename)%(Extension)" />
    <Compile Include="../../../Assets/Scripts/Electronics/*.cs" Link="Electronics/%(Filename)%(Extension)" />
    <Compile Include="../../../Assets/Scripts/Laboratory/BreadboardGrid.cs" Link="Laboratory/BreadboardGrid.cs" />
    <Compile Include="../../../Assets/Scripts/Laboratory/Breadboard.cs" Link="Laboratory/Breadboard.cs" />
    <Compile Include="../../../Assets/Scripts/Laboratory/LabMaterials.cs" Link="Laboratory/LabMaterials.cs" />
    <Compile Include="../../../Assets/Scripts/Laboratory/ComponentFactory.cs" Link="Laboratory/ComponentFactory.cs" />
    <Compile Include="../../../Assets/Tests/EditMode/BooleanExpressionTests.cs" Link="Tests/BooleanExpressionTests.cs" />
