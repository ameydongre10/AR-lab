{
  "name": "ar-lab",
  "version": "2.0.0",
  "description": "Interactive AR Digital Electronics Laboratory - Web & Mobile AR Platform",
  "type": "module",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build:client": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js",
    "build": "vite build && esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js",
    "start": "node dist/server/index.js",
    "test": "tsx --test tests/logic.test.js tests/api.test.js tests/server.test.js",
    "test:unity": "dotnet .github/workflows/support/bin/Debug/net9.0/CiRunner.dll",
    "generate:models": "node scripts/generate3dAssets.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ameydongre10/AR-lab.git"
  },
  "keywords": [
    "augmented-reality",
    "webxr",
    "digital-electronics",
    "logic-gates",
    "model-viewer",
    "edtech"
  ],
  "author": "Amey Dongre",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ameydongre10/AR-lab/issues"
  },
  "homepage": "https://github.com/ameydongre10/AR-lab#readme",
  "dependencies": {
    "@google/model-viewer": "^4.4.0",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "lucide-react": "^1.61.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
