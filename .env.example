# ==============================================================================
# AR LAB PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local overrides
# ==============================================================================

# Application port (Defaults to 3001 in dev, managed by host in production)
PORT=3001

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=production

# Persistence Directory (Defaults to ./data)
DATA_DIR=./data

# Optional Public Base URL for Mobile AR QR Code Generation (e.g., https://ar-lab.onrender.com)
PUBLIC_APP_URL=
